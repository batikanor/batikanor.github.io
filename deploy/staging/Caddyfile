:8080 {
    root * /releases/current
    encode zstd gzip

    @worker path /earth-cache-sw.js
    header @worker Cache-Control "no-cache"

    # The unversioned manifest selects the current fingerprinted JS entry.
    # Never give it the one-year asset TTL.
    @manifest path /assets/earth-current.json
    header @manifest Cache-Control "no-store"
    @immutable {
        path /assets/* /_next/static/*
        not path /assets/earth-current.json
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @data path /data/*
    header @data Cache-Control "public, max-age=3600"
    @html path / /index.html *.html */
    header @html Cache-Control "no-cache"

    # One fixed public feed, independent of immutable application releases.
    handle /site-data/gralobe-stars.json {
        rewrite * /stats/github/batikanor/gralobe.json
        reverse_proxy batikanor-release-artifacts:8080
    }

    file_server
}
