[Unit]
Description=Refresh Batikanor's verified Gralobe GitHub star count
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/batikanor-github-stars
ExecStart=/usr/bin/python3 /srv/apps/batikanor-github-stars/publish_github_stars.py
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/batikanor-github-stars/data /srv/apps/batikanor-release-artifacts/public/stats/github/batikanor
